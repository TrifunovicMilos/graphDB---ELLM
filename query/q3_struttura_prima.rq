PREFIX ex:   <http://example.org/semop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX wd:   <http://www.wikidata.org/entity/>
PREFIX wdt:  <http://www.wikidata.org/prop/direct/>
SELECT ?e ?label WHERE {
  { SELECT DISTINCT ?e WHERE {
      ?e a ex:VideoGame ; ex:inSet ex:set-main ; wdt:P178 ?dev .
      ?dev wdt:P17 wd:Q17 .
  } ORDER BY ?e LIMIT __N__ }
  ?e rdfs:label ?label .
  OPTIONAL { ?e ex:lead ?lead }
  FILTER( ex:sem_filter(?label, COALESCE(?lead, ""), "the game is a platformer") )
}