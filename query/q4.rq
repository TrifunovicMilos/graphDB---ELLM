PREFIX ex:   <http://example.org/semop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?e ?label ?genre WHERE {
  { SELECT ?e WHERE { ?e a ex:VideoGame ; ex:inSet ex:set-q4_input . } ORDER BY ?e LIMIT __N__ }
  ?e rdfs:label ?label .
  ?e ex:tau ?tau .
  BIND( ex:sem_classify(?tau, "the genre that describes the game best") AS ?genre )
}