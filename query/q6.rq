PREFIX ex:   <http://example.org/semop/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX wd:   <http://www.wikidata.org/entity/>
SELECT ?l ?r ?llabel ?rlabel WHERE {
  __VALUES_L__
  __VALUES_R__
  ?l ex:inSet ex:set-q6_left ; rdfs:label ?llabel .
  OPTIONAL { ?l ex:lead ?llead }
  ?r ex:inSet ex:set-q6_right ; rdfs:label ?rlabel .
  OPTIONAL { ?r ex:lead ?rlead }
  FILTER( ex:sem_join(?llabel, COALESCE(?llead, ""), ?rlabel, COALESCE(?rlead, ""), "the game is part of the series") )
}
